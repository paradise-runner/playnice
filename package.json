{
  "name": "playnice",
  "version": "0.1.0",
  "description": "Playwright for terminals \u2014 drive CLI/TUI apps and capture screenshots an agent can read.",
  "license": "MIT",
  "author": "Federico Jaramillo Martinez",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "playnice": "./bin/playnice.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/test/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/stamp.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^0.1.80",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "terminal",
    "tui",
    "playwright",
    "pty",
    "agent",
    "mcp",
    "testing",
    "screenshot"
  ],
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paradise-runner/playnice.git"
  },
  "homepage": "https://github.com/paradise-runner/playnice#readme",
  "bugs": {
    "url": "https://github.com/paradise-runner/playnice/issues"
  }
}
